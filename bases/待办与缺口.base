filters:
  and:
    - 'file.inFolder("wiki")'
    - 'file.ext == "md"'
    - or:
        - 'status == "stale"'
        - 'status == "draft"'

properties:
  type:
    displayName: 类型
  status:
    displayName: 状态
  updated:
    displayName: 更新

views:
  - type: table
    name: 待完善页面
    order:
      - file.name
      - type
      - status
      - updated
    groupBy:
      property: status
      direction: ASC
